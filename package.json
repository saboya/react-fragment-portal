{
  "name": "react-fragment-portal",
  "version": "0.0.1",
  "description": "Use React.createPortal without a container element",
  "type": "module",
  "main": "dist/index.cjs",
  "module": "dist/index.mjs",
  "types": "dist/index.d.ts",
  "exports": {
    "import": "./dist/index.mjs",
    "require": "./dist/index.cjs"
  },
  "scripts": {
    "build": "tsc-multi",
    "clean": "tsc-multi --clean",
    "lint": "oxlint -c ./.oxlintrc.json -D all && biome check . --linter-enabled=false",
    "format": "biome format --write .",
    "test": "vitest run --project unit",
    "test:browser": "vitest run --project browser",
    "test:all": "vitest run"
  },
  "peerDependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.2.56",
    "@types/react-dom": "^18.2.19",
    "@vitest/browser": "2.1.9",
    "@biomejs/biome": "^2.4.6",
    "jsdom": "^26.1.0",
    "oxlint": "^0.2.9",
    "playwright": "^1.52.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsc-multi": "^1.1.0",
    "typescript": "^5.3.3",
    "vitest": "^2.1.9",
    "vitest-browser-react": "^1.0.1"
  }
}
